# ── источники, рабочая зона, наработки (локально; в git не идут) ─────
база/источники/
база/_work/
наработки/
база/входящие/*
!база/входящие/.gitkeep

# ── производное (пересобирается: make chunk / catalog / clauses / report) ──
база/индекс/
база/каталог/
база/документы/_reports/

# ── python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Obsidian / ОС ────────────────────────────────────────────────────
база/.obsidian/
Thumbs.db
.DS_Store
