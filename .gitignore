# ── локальное (в git не идёт) ────────────────────────────────────────
.dev/            # внутренняя документация, планы, журналы
.tmp/            # рабочая зона сессий, рендеры, черновики
.sources/        # исходники docx/pdf/html (реестр — data/inventory.csv)
AGENTS.md        # наши внутренние инструкции агента (пример — AGENTS.md.sample)

# sidecar: артефакты конвейера внутри data/ (пересобираются, не публикуются)
data/**/*.qa.md
data/**/*.json
data/**/*.jsonl
data/**/_reports/

# ── python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Obsidian / ОС ────────────────────────────────────────────────────
.obsidian/
Thumbs.db
.DS_Store
