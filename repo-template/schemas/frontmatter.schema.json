{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/frontmatter.schema.json",
  "title": "Frontmatter of a canonical normative document",
  "type": "object",
  "required": [
    "doc_id",
    "designation",
    "kind",
    "title",
    "status",
    "language",
    "source",
    "conversion",
    "stats"
  ],
  "additionalProperties": true,
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable identifier: <kind>-<number-slug>[-<year>]. Never changes."
    },
    "designation": {
      "type": "string",
      "description": "Как цитировать: «СП 63.13330.2018»"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sp",
        "snip",
        "gost",
        "gost-r",
        "rd",
        "mds",
        "mdk",
        "vsn",
        "tsn",
        "npb",
        "posobie",
        "sto",
        "st-sev",
        "st-cks",
        "fer",
        "ter",
        "gesn",
        "sn",
        "rm",
        "rtm",
        "ost",
        "tu",
        "sanpin",
        "order",
        "other"
      ]
    },
    "number": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "title_short": {
      "type": "string"
    },
    "title_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "default": "ru"
    },
    "issuing_body": {
      "type": "string"
    },
    "issued": {
      "type": "string",
      "description": "Дата приказа/постановления, ISO 8601 или пусто"
    },
    "in_force_since": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "draft",
        "rejected",
        "unknown",
        "licensed",
        "suspended"
      ]
    },
    "status_checked": {
      "type": "string"
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "description": "Пусто для официальных документов: лицензия не применяется (ст. 1259 п.6 ГК РФ)"
    },
    "rights_note": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "okp_okpd": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenced_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "docx",
            "doc",
            "pdf",
            "xml-uz",
            "ocr",
            "html"
          ]
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "origin_url": {
          "type": "string"
        },
        "origin_date": {
          "type": "string"
        },
        "developer": {
          "type": "string"
        }
      }
    },
    "conversion": {
      "type": "object",
      "required": [
        "tool",
        "version",
        "confidence"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "converted_at": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "review_items": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "boolean",
          "default": false
        },
        "verified_by": {
          "type": "string"
        },
        "verified_at": {
          "type": "string"
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "words": {
          "type": "integer"
        },
        "clauses": {
          "type": "integer"
        },
        "headings": {
          "type": "object"
        },
        "tables": {
          "type": "integer"
        },
        "formulas": {
          "type": "integer"
        },
        "images": {
          "type": "integer"
        },
        "footnotes": {
          "type": "integer"
        },
        "pages": {
          "type": "integer"
        },
        "xrefs": {
          "type": "string"
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "полное + беспроигрышное + заменённые обозначения; механизм «ссылки не стареют» (docs/01 §4.9)"
    },
    "note_name": {
      "type": "string",
      "description": "имя файла заметки (designation кириллицей)"
    },
    "other_designations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions_since": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "даты исключений пунктов изменениями"
    },
    "excluded_clauses": {
      "type": "array",
      "description": "пункты, НЕ действующие в текущей редакции",
      "items": {
        "type": "object",
        "properties": {
          "clause": {
            "type": "string"
          },
          "range_to": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "amendment": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "vendor": {
      "type": "string",
      "description": "машинный провенанс экспорта СПС (единственное допустимое упоминание системы в заметке)"
    },
    "vendor_links_stripped": {
      "type": "integer",
      "description": "сколько вендорских ссылок снято очисткой"
    },
    "bibliography_entries": {
      "type": "integer"
    },
    "pages_source": {
      "type": "object",
      "description": "появляется после compare pages: привязка к пагинации издания",
      "properties": {
        "edition": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "file": {
          "type": "string"
        }
      }
    }
  }
}