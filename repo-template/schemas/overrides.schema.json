{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/overrides.schema.json",
  "title": "Manual metadata override for one document",
  "description": "Единственное место ручной правки метаданных. ПЛОСКИЙ YAML: любой ключ сливается с автодетекцией ПОСЛЕ распознавания — ручное значение побеждает. В рабочем vault файл живёт в правки/<doc_id>.yaml и передаётся флагом --meta-override (docx и pdf пути). Пересборка после правки — с --force (кэш считается по флагам, не по содержимому файла).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "doc_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Идентификатор файла правки; во фронтмэттер не пишется (doc_id всегда вычисляется конвертером)" },
    "title": { "type": "string" },
    "title_short": { "type": "string" },
    "designation": { "type": "string" },
    "number": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "superseded", "draft", "rejected", "unknown", "licensed", "suspended"] },
    "status_checked": { "type": "string", "format": "date" },
    "issuing_body": { "type": "string" },
    "issued": { "type": "string" },
    "in_force_since": { "type": "string" },
    "amendments": { "type": "array", "items": { "type": ["string", "integer"] } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "string" },
    "other_designations": { "type": "array", "items": { "type": "string" } },
    "exclusions_since": { "type": "array", "items": { "type": "string" } },
    "excluded_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause"],
        "properties": {
          "clause": { "type": "string" },
          "range_to": { "type": "string" },
          "since": { "type": "string" },
          "amendment": { "type": ["string", "integer"] }
        }
      }
    },
    "topics": { "type": "array", "items": { "type": "string" } },
    "ics": { "type": "array", "items": { "type": "string" } },
    "okp_okpd": { "type": "string" },
    "rights_note": { "type": "string" },
    "origin_url": { "type": "string", "description": "попадает в source.origin_url" },
    "origin_date": { "type": "string", "description": "попадает в source.origin_date" },
    "publisher": { "type": "string", "description": "попадает в source.publisher" },
    "text_layer": { "type": "string", "description": "попадает в source.text_layer" },
    "verified": { "type": "boolean", "description": "ставит ТОЛЬКО человек; во фронтмэттере — conversion.verified" },
    "verified_by": { "type": "string" },
    "verified_at": { "type": "string", "format": "date" }
  }
}
